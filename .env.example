# Required for working contact links. Digits only for WhatsApp, with country code.
# Example: VITE_WHATSAPP_NUMBER=919876543210
VITE_CONTACT_EMAIL=hello@yourdomain.com
VITE_WHATSAPP_NUMBER=
VITE_SITE_URL=https://health.tokenly.in

# Optional: Formspree endpoint for real form submissions.
# Create a form at https://formspree.io and paste the endpoint URL.
# Example: VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=
